/proc/chinese_admin_trait_choice(mob/user, message, title, list/choices)
	var/list/names = chinese_admin_trait_names()
	var/list/display_choices = list()
	for(var/key in choices)
		var/translated = names[choices[key]]
		display_choices[translated ? "[translated]（[key]）" : key] = key
	var/selected = input(user, message, title) as null|anything in sort_list(display_choices)
	return isnull(selected) ? null : display_choices[selected]

